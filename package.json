{
  "name": "@glamsystems/glam-sdk",
  "version": "1.2.1",
  "description": "TypeScript SDK for the GLAM Protocol",
  "main": "./index.cjs.js",
  "module": "./index.esm.js",
  "types": "./index.esm.d.ts",
  "homepage": "https://www.glam.systems",
  "repository": {
    "type": "git",
    "url": "https://github.com/glamsystems/glam-sdk-ts-legacy.git"
  },
  "keywords": [
    "glam",
    "solana"
  ],
  "license": "Apache-2.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "node scripts/clean.mjs",
    "prepack": "npm run build",
    "pack:dry-run": "npm pack --dry-run --json"
  },
  "files": [
    "README.md",
    "LICENSE",
    "buffer-layout.d.ts",
    "index.cjs.js",
    "index.esm.js",
    "index.cjs.d.ts",
    "index.esm.d.ts",
    "src/**/*.d.ts",
    "target/idl/**/*.json",
    "target/types/**/*.ts",
    "target/types/**/*.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "allowScripts": {
    "bigint-buffer": false,
    "bufferutil": false,
    "esbuild": false,
    "utf-8-validate": false
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.31.1",
    "@coral-xyz/borsh": "0.31.1",
    "@ellipsis-labs/rise": "0.4.66",
    "@glamsystems/ix-mapper": "0.2.4",
    "@glamsystems/sanctum-lst-list": "0.2.55",
    "@marinade.finance/marinade-ts-sdk": "5.0.15",
    "@solana/spl-stake-pool": "1.1.8",
    "@solana/spl-token": "0.4.13",
    "@solana/spl-token-metadata": "0.1.6",
    "@solana/kit": "4.0.0",
    "@solana/web3.js": "1.99.0",
    "@types/bn.js": "5.2.0",
    "buffer": "6.0.3",
    "decimal.js": "10.6.0",
    "fzstd": "0.1.1",
    "zod": "4.6.7"
  },
  "engines": {
    "node": "^24.22.3 || ^26.13.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.30",
    "esbuild": "^0.28.1",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "bigint-buffer@1.1.5": "npm:@exodus/bigint-buffer@1.1.5-exodus.1",
    "@solana/web3.js@>=0.0.1": "1.99.0",
    "@solana/spl-token@>=0.0.1": "0.4.13",
    "@solana/spl-stake-pool@>=0.0.1": "1.1.8",
    "typescript@>=0.0.1": "$typescript",
    "solana-bankrun@>=0.0.1": "0.3.0",
    "bn.js@>=5.0.0 <5.2.5": "5.2.5",
    "jayson@>=4.0.0 <5.0.0": {
      ".": "5.0.0",
      "ws@>=7.0.0 <7.5.11": "7.5.11"
    },
    "jayson": {
      "ws@>=7.0.0 <7.5.11": "7.5.11"
    },
    "rpc-websockets": {
      "ws@>=8.0.0 <8.21.0": "8.21.0"
    },
    "toml@>=3.0.0 <5.0.1": "5.0.1",
    "uuid@>=8.0.0 <11.1.1": "11.1.1",
    "serialize-javascript@>=6.0.0 <7.1.3": "7.1.3",
    "zod@>=4.0.0 <4.6.7": "4.6.7"
  }
}
